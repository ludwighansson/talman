{
  "$defs": {
    "customization": {
      "additionalProperties": false,
      "properties": {
        "bootloader": {
          "description": "none, dual-boot, sd-boot or grub, in any case.",
          "pattern": "^([nN][oO][nN][eE]|[dD][uU][aA][lL]-[bB][oO][oO][tT]|[sS][dD]-[bB][oO][oO][tT]|[gG][rR][uU][bB])$",
          "type": [
            "string",
            "null"
          ]
        },
        "diskImage": {
          "anyOf": [
            {
              "$ref": "#/$defs/diskImage"
            },
            {
              "type": "null"
            }
          ]
        },
        "embeddedMachineConfiguration": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "extraKernelArgs": {
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "meta": {
          "items": {
            "$ref": "#/$defs/metaValue"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "secureboot": {
          "anyOf": [
            {
              "$ref": "#/$defs/schematicSecureBoot"
            },
            {
              "type": "null"
            }
          ]
        },
        "systemExtensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/systemExtensions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "diskImage": {
      "additionalProperties": false,
      "properties": {
        "sectorSize": {
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "imageFactory": {
      "additionalProperties": false,
      "properties": {
        "installerURLTmpl": {
          "description": "The installer image reference, as a Go template over .RegistryURL, .Protocol, .ID, .Version, .Platform (or .Mode) and .SecureBoot.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "platform": {
          "description": "The installer's platform: metal, openstack, aws, …. Default: metal.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "protocol": {
          "description": "The protocol schematics are submitted over. Default: https.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "registryURL": {
          "description": "The Image Factory host. Default: factory.talos.dev.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "schematicEndpoint": {
          "description": "The path schematics are submitted to. Default: /schematics.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "secureBoot": {
          "description": "Use the secure boot installer. Default: false.",
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "metaValue": {
      "additionalProperties": false,
      "properties": {
        "key": {
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        }
      },
      "required": [
        "key",
        "value"
      ],
      "type": "object"
    },
    "node": {
      "additionalProperties": false,
      "not": {
        "required": [
          "schematic",
          "schematicID"
        ]
      },
      "properties": {
        "groups": {
          "description": "Groups whose patches this node receives, applied in this order after its role's.",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "hostname": {
          "description": "An RFC 1123 host name: the Kubernetes node name, and the rendered file's name.",
          "maxLength": 253,
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$",
          "type": "string"
        },
        "imageFactory": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/imageFactory"
                }
              ],
              "description": "Overrides the cluster's imageFactory key by key for this node."
            },
            {
              "type": "null"
            }
          ]
        },
        "ipAddress": {
          "description": "The address talman reaches the node at.",
          "type": [
            "string",
            "number"
          ]
        },
        "patches": {
          "description": "This node's own patches, applied last.",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        },
        "role": {
          "description": "controlplane or worker.",
          "enum": [
            "controlplane",
            "worker"
          ]
        },
        "schematic": {
          "anyOf": [
            {
              "description": "Overrides the cluster's schematic for this node.",
              "oneOf": [
                {
                  "description": "A path to a schematic file.",
                  "minLength": 1,
                  "type": "string"
                },
                {
                  "$ref": "#/$defs/schematic"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "schematicID": {
          "description": "Overrides the cluster's schematic with an ID for this node.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "talosVersion": {
          "description": "Overrides the cluster's talosVersion for this node.",
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "values": {
          "description": "Free-form data, available to this node's patch templates as .Node.Values.",
          "type": [
            "object",
            "null"
          ]
        },
        "valuesFiles": {
          "description": "YAML files merged into this node's values, in order and beneath its inline map.",
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "hostname",
        "ipAddress",
        "role"
      ],
      "type": "object"
    },
    "overlay": {
      "additionalProperties": false,
      "properties": {
        "image": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "name": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "options": {
          "type": [
            "object",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "rollout": {
      "additionalProperties": false,
      "properties": {
        "soak": {
          "description": "How long to wait after each wave before the next, e.g. 10m.",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "type": [
            "string",
            "null"
          ]
        },
        "waves": {
          "description": "Waves in order. A node goes in the first that names its role or a group of its; the rest go last.",
          "items": {
            "oneOf": [
              {
                "description": "One group, or a role.",
                "type": "string"
              },
              {
                "description": "Several groups, rolled out together.",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            ]
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "waves"
      ],
      "type": "object"
    },
    "schematic": {
      "additionalProperties": false,
      "properties": {
        "customization": {
          "anyOf": [
            {
              "$ref": "#/$defs/customization"
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay": {
          "anyOf": [
            {
              "$ref": "#/$defs/overlay"
            },
            {
              "type": "null"
            }
          ]
        },
        "owner": {
          "type": [
            "string",
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "schematicSecureBoot": {
      "additionalProperties": false,
      "properties": {
        "enrollKeys": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "includeWellKnownCertificates": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "systemExtensions": {
      "additionalProperties": false,
      "properties": {
        "officialExtensions": {
          "items": {
            "type": [
              "string",
              "number"
            ]
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "https://raw.githubusercontent.com/ludwighansson/talman/main/schema/talman.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A talman cluster config, schema talman.dev/v1.",
  "not": {
    "required": [
      "schematic",
      "schematicID"
    ]
  },
  "properties": {
    "apiVersion": {
      "const": "talman.dev/v1",
      "description": "The schema this file is written against."
    },
    "clusterName": {
      "description": "The cluster's name, as talosctl gen config takes it.",
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,252}$",
      "type": "string"
    },
    "endpoint": {
      "description": "The Kubernetes API URL: https, with a port.",
      "pattern": "^https://[^/]+:[0-9]+(/.*)?$",
      "type": "string"
    },
    "imageFactory": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/imageFactory"
            }
          ],
          "description": "Where installer images come from and how their references are spelled."
        },
        {
          "type": "null"
        }
      ]
    },
    "kubernetesVersion": {
      "description": "The Kubernetes version configs are rendered for, and upgrade-k8s upgrades to.",
      "type": [
        "string",
        "number"
      ]
    },
    "nodes": {
      "description": "Every machine in the cluster.",
      "items": {
        "$ref": "#/$defs/node"
      },
      "minItems": 1,
      "type": "array"
    },
    "outputDir": {
      "description": "Where rendered configs, the talosconfig and the kubeconfig are written. Default: clusterconfig.",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "patches": {
      "additionalProperties": {
        "items": {
          "type": [
            "string",
            "number"
          ]
        },
        "type": [
          "array",
          "null"
        ]
      },
      "description": "Patch files by group: all, controlplane, worker, or a group some node declares. Applied in that order.",
      "type": [
        "object",
        "null"
      ]
    },
    "rollout": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/rollout"
            }
          ],
          "description": "The order upgrade, reboot and apply take through the cluster, in waves of groups."
        },
        {
          "type": "null"
        }
      ]
    },
    "schematic": {
      "anyOf": [
        {
          "description": "The Image Factory schematic: inline, or a path to a (templated) file.",
          "oneOf": [
            {
              "description": "A path to a schematic file.",
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/schematic"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "schematicID": {
      "description": "A schematic ID to use as is, instead of a schematic.",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "secretFile": {
      "description": "The (usually SOPS-encrypted) Talos secrets bundle. Default: secrets.sops.yaml.",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "talosVersion": {
      "description": "The Talos version contract configs are rendered for. Pinning it makes renders reproducible.",
      "type": [
        "string",
        "number"
      ]
    },
    "talosctl": {
      "description": "The talosctl binary talman drives. Default: talosctl on PATH.",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "validationMode": {
      "description": "The talosctl validate --mode. Default: metal for the metal platform, cloud otherwise.",
      "enum": [
        "metal",
        "cloud",
        "container"
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "values": {
      "description": "Free-form data, available to every patch template as .Values.",
      "type": [
        "object",
        "null"
      ]
    },
    "valuesFiles": {
      "description": "YAML files merged into values, in order and beneath the inline map. Plaintext only.",
      "items": {
        "type": [
          "string",
          "number"
        ]
      },
      "type": [
        "array",
        "null"
      ]
    }
  },
  "required": [
    "apiVersion",
    "clusterName",
    "endpoint",
    "talosVersion",
    "kubernetesVersion",
    "nodes"
  ],
  "title": "talman.yaml",
  "type": "object"
}
